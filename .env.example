# SolanaScanner Environment Configuration

# CoinGecko API key
COINGECKO_API_KEY=your_coingecko_api_key

# Telegram configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---------------------------------------------------------------------------
# LLM providers - free tiers, rotated by free_llm.py
# ---------------------------------------------------------------------------
# Set AT LEAST ONE of these; two or more is the point, since the rotation moves
# on when a provider rate-limits you. All are no-credit-card signups.
# Verify what you have configured with:   python free_llm.py
#
#   GROQ        https://console.groq.com/keys
#   CEREBRAS    https://cloud.cerebras.ai/
#   GEMINI      https://aistudio.google.com/apikey
#   MISTRAL     https://console.mistral.ai/api-keys/
#   OPENROUTER  https://openrouter.ai/keys        (use the :free models)
#   NVIDIA      https://build.nvidia.com/
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional rotation tuning:
#   FREE_LLM_ORDER=groq,cerebras,gemini      subset and/or reorder the rotation
#   FREE_LLM_GROQ_MODEL=some-new-model-id    override a retired model id
#   FREE_LLM_TIMEOUT=15                      seconds allowed per provider
#   FREE_LLM_TOTAL_BUDGET=45                 seconds allowed for a whole rotation

# OpenAI API key - NO LONGER USED. The scanner never makes a paid call; when
# every free provider is throttled it degrades instead. Left here only so an
# existing .env does not look broken.
OPENAI_API_KEY=

# Twilio configuration (optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Scanner settings
SCAN_INTERVAL=120
DEFAULT_BUY_AMOUNT=0.1
MAX_MARKET_CAP=100000000
MIN_PRICE_CHANGE=3
MIN_LIQUIDITY_RATIO=0.02
MAX_PRICE_DROP=-25
MIN_VOLUME=500
SIGNAL_COOLDOWN=600
SENTIMENT_THRESHOLD=0.5

# Server configuration - IMPORTANT FOR 3D CHART ACCESS
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Set this to your publicly accessible URL for the quantum chart function
# Examples:
# - If using ngrok: PUBLIC_URL=https://your-ngrok-url.ngrok.io
# - If deployed to a server: PUBLIC_URL=https://your-domain.com
# - If using public IP: PUBLIC_URL=http://your-public-ip:5000
PUBLIC_URL= 